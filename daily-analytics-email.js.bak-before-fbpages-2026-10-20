// api/daily-analytics-email.js
// Vercel Cron job (see vercel.json — runs once daily): gathers yesterday's
// numbers from every analytics source the CRM's own Analytics tab shows
// (GA4, WordPress.com/Jetpack, Facebook Ads + Page, Mailchimp), asks Claude
// to write a plain-English summary and recommendations, and sends the
// result as a real email via Microsoft Graph (Outlook) — no click required,
// unlike every other "send" in this app, which only ever prepares a draft.
// That's a deliberate, explicit exception: this endpoint is authorized to
// send unattended because it exists specifically to enable a genuinely
// automatic daily report, not as a general-purpose sender.
//
// Each data source uses a long-lived credential stored server-side (this
// job has no browser and can't use the CRM's own localStorage tokens):
//   DRIVE_SERVER_REFRESH_TOKEN   Google refresh token (already used by
//                                 api/secure-sync.js) — DRIVE_SCOPE already
//                                 includes analytics.readonly, so the same
//                                 token works for GA4 too.
//   WP_SERVER_ACCESS_TOKEN       WordPress.com access token, copied from
//                                 the browser's mm_wp_token. WordPress.com
//                                 tokens don't expire on their own, so this
//                                 is normally a set-once value.
//   FB_SERVER_ACCESS_TOKEN       Facebook long-lived user token, copied
//                                 from the browser's mm_fb_token. Unlike
//                                 Google/Microsoft, Facebook user tokens
//                                 have no true refresh flow — this expires
//                                 every ~60 days and needs re-pasting then.
//   MS_NOTIFY_CLIENT_ID /        App-only Microsoft sign-in (client credentials) for
//   MS_NOTIFY_CLIENT_SECRET       the "Miles Man Upload Notifier" Entra app, which has
//                                 Mail.Send application permission. The secret expires
//                                 (max 24 months) and must be rotated. NOT a stored
//                                 refresh token: SPA refresh tokens die after 24 hours.
//   CRON_SECRET                  Random string; Vercel Cron sends it as a Bearer token and
//                                 this endpoint rejects any request without it.
//   MAILCHIMP_API_KEY            Already set (existing Mailchimp Activity
//                                 Sync feature).
//   ANTHROPIC_API_KEY            Already set (existing Assistant feature).
// Optional:
//   MAILCHIMP_LIST_ID            Skips an extra /lists call. If unset, and
//                                 the account has exactly one audience,
//                                 that one is used automatically.
//   DIGEST_RECIPIENT_EMAIL       Required — no default, since guessing
//                                 wrong means silently emailing nobody (or
//                                 the wrong person).
//
// Every source is fetched independently and wrapped so one failing (an
// expired FB token, a missing env var) doesn't block the others — the
// digest goes out with whatever data succeeded, plus a plain note on
// anything that didn't, rather than the whole job silently doing nothing.

const GOOGLE_CLIENT_SECRET = process.env.GOOGLE_CLIENT_SECRET;
const DRIVE_SERVER_REFRESH_TOKEN = process.env.DRIVE_SERVER_REFRESH_TOKEN;
const WP_SERVER_ACCESS_TOKEN = process.env.WP_SERVER_ACCESS_TOKEN;
const FB_SERVER_ACCESS_TOKEN = process.env.FB_SERVER_ACCESS_TOKEN;
const MAILCHIMP_API_KEY = process.env.MAILCHIMP_API_KEY;
const ANTHROPIC_API_KEY = process.env.ANTHROPIC_API_KEY;
const MAILCHIMP_LIST_ID = process.env.MAILCHIMP_LIST_ID;
const DIGEST_RECIPIENT_EMAIL = process.env.DIGEST_RECIPIENT_EMAIL;

const DRIVE_CLIENT_ID = '1055867383042-an9l58o1qg22pt7o4ak8vaneeftv54ib.apps.googleusercontent.com';
const GA4_PROPERTY_ID = '362931402';
const WP_SITE = 'themilesman.com';
const FB_AD_ACCOUNT = 'act_1285326830438388';
const FB_GRAPH_VERSION = 'v21.0';
const MS_TENANT_ID = 'a9346e69-975d-4abb-861a-dea6e2464642';

function yesterdayDateStr() {
  const d = new Date();
  d.setUTCDate(d.getUTCDate() - 1);
  return d.toISOString().slice(0, 10);
}

async function getGoogleAccessToken() {
  if (!DRIVE_SERVER_REFRESH_TOKEN || !GOOGLE_CLIENT_SECRET) throw new Error('DRIVE_SERVER_REFRESH_TOKEN or GOOGLE_CLIENT_SECRET not set');
  const params = new URLSearchParams();
  params.set('client_id', DRIVE_CLIENT_ID);
  params.set('client_secret', GOOGLE_CLIENT_SECRET);
  params.set('grant_type', 'refresh_token');
  params.set('refresh_token', DRIVE_SERVER_REFRESH_TOKEN);
  const r = await fetch('https://oauth2.googleapis.com/token', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: params.toString()
  });
  const data = await r.json();
  if (!r.ok) throw new Error('Google refresh failed: ' + (data.error_description || data.error));
  return data.access_token;
}

async function fetchGA4(dateStr) {
  const token = await getGoogleAccessToken();
  const r = await fetch('https://analyticsdata.googleapis.com/v1beta/properties/' + GA4_PROPERTY_ID + ':runReport', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
    body: JSON.stringify({
      dateRanges: [{ startDate: dateStr, endDate: dateStr }],
      metrics: [{ name: 'activeUsers' }, { name: 'screenPageViews' }, { name: 'sessions' }]
    })
  });
  const data = await r.json();
  if (data.error) throw new Error('GA4: ' + (data.error.message || JSON.stringify(data.error)));
  const row = (data.rows || [])[0];
  const vals = row ? row.metricValues.map(function (m) { return m.value; }) : ['0', '0', '0'];
  return { activeUsers: vals[0], pageViews: vals[1], sessions: vals[2] };
}

async function fetchWordPress(dateStr) {
  if (!WP_SERVER_ACCESS_TOKEN) throw new Error('WP_SERVER_ACCESS_TOKEN not set');
  // /stats/visits (tried originally here, and in the CRM's own client-side
  // equivalent) returns "unauthorized" from WordPress.com despite a valid
  // token, for reasons never pinned down — /stats itself is the proven
  // endpoint the CRM's own Analytics tab card already uses successfully,
  // and its visits.data array carries the same [date, views, visitors] rows.
  const r = await fetch('https://public-api.wordpress.com/rest/v1.1/sites/' + WP_SITE + '/stats', {
    headers: { Authorization: 'Bearer ' + WP_SERVER_ACCESS_TOKEN }
  });
  const data = await r.json();
  if (data.error) throw new Error('WordPress: ' + (data.error_description || data.error));
  const rows = (data.visits && data.visits.data) || [];
  const day = rows.find(function (r) { return r[0] === dateStr; });
  if (!day) return { views: 0, visitors: 0 };
  return { views: day[1], visitors: day[2] };
}

async function fbGraphServer(path, query) {
  const qs = query ? '?' + new URLSearchParams(query).toString() : '';
  const r = await fetch('https://graph.facebook.com/' + FB_GRAPH_VERSION + path + qs, {
    headers: { Authorization: 'Bearer ' + FB_SERVER_ACCESS_TOKEN }
  });
  const data = await r.json();
  if (data.error) throw new Error('Facebook: ' + data.error.message);
  return data;
}

async function fetchFacebookAds(dateStr) {
  if (!FB_SERVER_ACCESS_TOKEN) throw new Error('FB_SERVER_ACCESS_TOKEN not set');
  const data = await fbGraphServer('/' + FB_AD_ACCOUNT + '/insights', {
    level: 'account', time_range: JSON.stringify({ since: dateStr, until: dateStr }),
    fields: 'spend,impressions,clicks,cpc'
  });
  const row = (data.data || [])[0];
  return row ? { spend: row.spend, impressions: row.impressions, clicks: row.clicks } : { spend: 0, impressions: 0, clicks: 0 };
}

async function fetchFacebookPage(dateStr) {
  if (!FB_SERVER_ACCESS_TOKEN) throw new Error('FB_SERVER_ACCESS_TOKEN not set');
  const pages = await fbGraphServer('/me/accounts', { fields: 'id,name,access_token' });
  const page = (pages.data || [])[0];
  if (!page) throw new Error('Facebook: no managed Page found');
  // page_impressions deprecated by Meta (confirmed live: "(#100) The
  // value must be a valid insights metric") — page_media_view is the
  // confirmed-working replacement.
  const qs = new URLSearchParams({ metric: 'page_views_total,page_media_view,page_post_engagements', period: 'day', since: dateStr, until: dateStr });
  const r = await fetch('https://graph.facebook.com/' + FB_GRAPH_VERSION + '/' + page.id + '/insights?' + qs.toString(), {
    headers: { Authorization: 'Bearer ' + page.access_token }
  });
  const data = await r.json();
  if (data.error) throw new Error('Facebook Page: ' + data.error.message);
  const byName = {};
  (data.data || []).forEach(function (m) { byName[m.name] = (m.values || [])[0]; });
  return {
    pageName: page.name,
    views: byName.page_views_total ? byName.page_views_total.value : 0,
    impressions: byName.page_media_view ? byName.page_media_view.value : 0,
    engagements: byName.page_post_engagements ? byName.page_post_engagements.value : 0
  };
}

async function mailchimpGet(path) {
  if (!MAILCHIMP_API_KEY) throw new Error('MAILCHIMP_API_KEY not set');
  const dc = MAILCHIMP_API_KEY.split('-').pop();
  const auth = Buffer.from('anystring:' + MAILCHIMP_API_KEY).toString('base64');
  const r = await fetch('https://' + dc + '.api.mailchimp.com/3.0' + path, { headers: { Authorization: 'Basic ' + auth } });
  const data = await r.json();
  if (!r.ok) throw new Error('Mailchimp: ' + (data.detail || data.title || r.status));
  return data;
}

async function getMailchimpListId() {
  if (MAILCHIMP_LIST_ID) return MAILCHIMP_LIST_ID;
  const data = await mailchimpGet('/lists?count=100');
  const lists = data.lists || [];
  if (lists.length === 1) return lists[0].id;
  throw new Error('MAILCHIMP_LIST_ID not set and account has ' + lists.length + ' audiences (need exactly 1 to auto-pick)');
}

async function fetchMailchimp() {
  const listId = await getMailchimpListId();
  const list = await mailchimpGet('/lists/' + listId);
  const stats = list.stats || {};
  return {
    listName: list.name,
    subscribers: stats.member_count,
    unsubscribed: stats.unsubscribe_count,
    openRate: stats.open_rate,
    clickRate: stats.click_rate
  };
}

// App-only (client credentials) sign-in as the dedicated "Miles Man Upload
// Notifier" Entra app (Mail.Send application permission, admin-consented) -
// the same one api/cc-auth-upload.js uses. The old stored refresh token came
// from the CRM's single-page-app registration, whose refresh tokens have a
// fixed 24-hour life (AADSTS700084), so an unattended job can never hold one.
const MS_SENDER_MAILBOX = 'eric@themilesman.com';

async function getMsAccessToken() {
  const clientId = process.env.MS_NOTIFY_CLIENT_ID;
  const clientSecret = process.env.MS_NOTIFY_CLIENT_SECRET;
  if (!clientId || !clientSecret) throw new Error('MS_NOTIFY_CLIENT_ID / MS_NOTIFY_CLIENT_SECRET not set');
  const params = new URLSearchParams();
  params.set('client_id', clientId);
  params.set('client_secret', clientSecret);
  params.set('grant_type', 'client_credentials');
  params.set('scope', 'https://graph.microsoft.com/.default');
  const r = await fetch('https://login.microsoftonline.com/' + MS_TENANT_ID + '/oauth2/v2.0/token', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: params.toString()
  });
  const data = await r.json();
  if (!r.ok || !data.access_token) throw new Error('Microsoft sign-in failed: ' + (data.error_description || data.error));
  return data.access_token;
}

async function sendDigestEmail(bodyHtml, subject) {
  const token = await getMsAccessToken();
  const r = await fetch('https://graph.microsoft.com/v1.0/users/' + encodeURIComponent(MS_SENDER_MAILBOX) + '/sendMail', {
    method: 'POST',
    headers: { Authorization: 'Bearer ' + token, 'Content-Type': 'application/json' },
    body: JSON.stringify({
      message: {
        subject: subject,
        body: { contentType: 'HTML', content: bodyHtml },
        toRecipients: [{ emailAddress: { address: DIGEST_RECIPIENT_EMAIL } }]
      }
    })
  });
  if (r.status !== 202) {
    const text = await r.text();
    throw new Error('Outlook sendMail failed (' + r.status + '): ' + text.slice(0, 300));
  }
}

async function summarizeWithClaude(statsText, dateStr) {
  if (!ANTHROPIC_API_KEY) throw new Error('ANTHROPIC_API_KEY not set');
  const r = await fetch('https://api.anthropic.com/v1/messages', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'x-api-key': ANTHROPIC_API_KEY, 'anthropic-version': '2023-06-01' },
    body: JSON.stringify({
      model: 'claude-sonnet-5',
      max_tokens: 1024,
      system: 'You write short, plain-English daily marketing analytics summaries for a small travel agency owner (Miles Man Travel) who is not a data analyst. Given raw stats for one day, write: (1) a 2-3 sentence plain-English summary of what happened, (2) 2-4 bullet-point observations worth noting (good or bad, only if genuinely notable — do not manufacture insight from noise in small numbers), (3) 1-3 concrete, specific recommended actions for today. No fluff, no generic advice like "keep posting consistently." If a data source is missing/failed, just skip it silently in the summary rather than commenting on the outage.',
      messages: [{ role: 'user', content: 'Yesterday (' + dateStr + ') stats:\n\n' + statsText }]
    })
  });
  const data = await r.json();
  if (data.error) throw new Error('Claude: ' + data.error.message);
  const block = (data.content || []).find(function (b) { return b.type === 'text'; });
  return block ? block.text : '(no summary generated)';
}

function escapeHtml(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}

module.exports = async function handler(req, res) {
  // Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" automatically when
  // the CRON_SECRET env var is set. Without this check anyone who found the
  // URL could trigger an email and a paid Claude call.
  const cronSecret = process.env.CRON_SECRET;
  if (!cronSecret) {
    res.status(500).json({ error: 'server_misconfigured', error_description: 'CRON_SECRET is not set' });
    return;
  }
  if (req.headers.authorization !== 'Bearer ' + cronSecret) {
    res.status(401).json({ error: 'unauthorized' });
    return;
  }
  if (!DIGEST_RECIPIENT_EMAIL) {
    res.status(500).json({ error: 'server_misconfigured', error_description: 'DIGEST_RECIPIENT_EMAIL is not set' });
    return;
  }

  const dateStr = yesterdayDateStr();
  const sections = [];
  const failures = [];

  async function tryFetch(label, fn) {
    try {
      const result = await fn();
      sections.push(label + ':\n' + JSON.stringify(result, null, 2));
    } catch (err) {
      failures.push(label + ': ' + (err && err.message ? err.message : err));
    }
  }

  await tryFetch('Google Analytics (GA4)', function () { return fetchGA4(dateStr); });
  await tryFetch('WordPress.com / Jetpack', function () { return fetchWordPress(dateStr); });
  await tryFetch('Facebook Ads', function () { return fetchFacebookAds(dateStr); });
  await tryFetch('Facebook Page (organic)', function () { return fetchFacebookPage(dateStr); });
  await tryFetch('Mailchimp', function () { return fetchMailchimp(); });

  const statsText = sections.length ? sections.join('\n\n') : '(no data sources succeeded)';

  let summaryHtml;
  try {
    const summaryText = await summarizeWithClaude(statsText, dateStr);
    summaryHtml = '<div style="white-space:pre-wrap;font-family:sans-serif;font-size:14px;line-height:1.5">' + escapeHtml(summaryText) + '</div>';
  } catch (err) {
    summaryHtml = '<p style="color:#b91c1c">Summary generation failed: ' + escapeHtml(err.message) + '</p>' +
      '<pre style="font-size:12px;background:#f3f4f6;padding:10px;border-radius:6px">' + escapeHtml(statsText) + '</pre>';
  }

  const failuresHtml = failures.length
    ? '<p style="color:#b45309;font-size:12px;margin-top:20px">Not included today (check server env vars): ' + escapeHtml(failures.join(' · ')) + '</p>'
    : '';

  const bodyHtml = '<div style="font-family:sans-serif;max-width:600px">' +
    '<h2 style="font-family:sans-serif">Miles Man Daily Analytics — ' + dateStr + '</h2>' +
    summaryHtml + failuresHtml +
    '</div>';

  try {
    await sendDigestEmail(bodyHtml, 'Miles Man Daily Analytics — ' + dateStr);
    res.status(200).json({ ok: true, date: dateStr, failures: failures });
  } catch (err) {
    res.status(500).json({ error: 'send_failed', error_description: err.message, date: dateStr, failures: failures });
  }
};
